Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RSolve", "[", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", 
     RowBox[{"n", "+", "1"}], "]"}], "==", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"a", "[", "n", "]"}]}], "-", "c"}]}], ",", 
   RowBox[{"a", "[", "n", "]"}], ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.989551826940358*^9, 3.989551867785721*^9}, {
  3.9895533488911543`*^9, 3.989553359091737*^9}, {3.989553411541155*^9, 
  3.989553414164274*^9}, {3.9895534529143553`*^9, 3.989553454064307*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"3b94be62-3cb6-48d4-b259-724a494a3252"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"c", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         SuperscriptBox["c", "n"]}], ")"}]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", "c"}]], "+", 
     RowBox[{
      SuperscriptBox["c", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], " ", 
      TemplateBox[{"1"},
       "C"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{
  3.989551868813949*^9, {3.98955335483055*^9, 3.9895533594147453`*^9}, 
   3.9895534166669283`*^9, 3.989553454594245*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"67970197-fc16-4355-87b3-93059533971a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "==", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"c", "^", "k"}], " ", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"-", "c"}], "]"}], "/", 
         RowBox[{"k", "!"}]}], " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"k", "+", "n"}], ")"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], "c", " ", 
     RowBox[{"a", "[", 
      RowBox[{"n", "+", "1"}], "]"}]}]}], ",", 
   RowBox[{"a", "[", "n", "]"}], ",", "n"}], "]"}]], "Input",
 CellChangeTimes->{{3.989552292766754*^9, 3.98955231864685*^9}, {
  3.989554588331834*^9, 3.989554625821451*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"0afd143c-c2c4-4cc6-bf7d-c27fdaeba070"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "[", "n", "]"}], "\[Rule]", 
    RowBox[{
     TemplateBox[{"1"},
      "C"], " ", 
     RowBox[{
      UnderoverscriptBox["\[Product]", 
       RowBox[{
        RowBox[{"K", "[", "1", "]"}], "=", "1"}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}]], 
      FractionBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "c"}], ")"}], 
         RowBox[{"K", "[", "1", "]"}]], " ", 
        SuperscriptBox["\[ExponentialE]", "c"]}], 
       RowBox[{"c", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Gamma", "[", 
           RowBox[{"K", "[", "1", "]"}], "]"}], "-", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            RowBox[{"K", "[", "1", "]"}], ",", 
            RowBox[{"-", "c"}]}], "]"}]}], ")"}]}]]}]}]}], "}"}], 
  "}"}]], "Output",
 CellChangeTimes->{3.98955231929195*^9, 3.98955462821318*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"b30a4ff9-a4f9-4886-8562-d690368f0862"]
}, Open  ]],

