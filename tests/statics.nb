Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Product", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "^", 
           RowBox[{"(", 
            RowBox[{"-", "j"}], ")"}]}], 
          RowBox[{
           RowBox[{"P", "[", 
            RowBox[{"l", ",", "b", ",", "mu", ",", 
             RowBox[{"b", " ", "j"}], " ", ",", "2"}], "]"}], "/", 
           RowBox[{
