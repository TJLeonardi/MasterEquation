Cell[BoxData[
 RowBox[{"Product", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"i", " ", "b"}], " ", "+", " ", 
    RowBox[{"c", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"i", " ", 
         RowBox[{"b", "^", "2"}]}], " ", "+", " ", 
        RowBox[{"mu", " ", "b"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"mu", " ", "+", " ", 
        RowBox[{"b", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "i"}], ")"}]}]}], ")"}]}]}]}], ",", 
   RowBox[{"{", 
