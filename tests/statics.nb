Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "I"}], " ", "w", " ", "x"}], " ", "+", 
      RowBox[{"c", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "b"}], " ", "x"}], "]"}]}]}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", " ", "b"}], " ", "x"}], "]"}]}], ")"}]}], ",", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.988793917108822*^9, 3.98879392944233*^9}, {
  3.988795772649259*^9, 3.9887958385838623`*^9}, {3.988795902611033*^9, 
  3.988795919221546*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"41410d34-e9be-4f67-afc1-60372a047a23"],

Cell[BoxData[
 RowBox[{"\[Integral]", 
  RowBox[{
   FractionBox[
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"c", " ", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "b"}], " ", "x"}]]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "w", " ", "x"}]}]], 
    RowBox[{"1", "-", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "b"}], " ", "x"}]]}]], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Output",
 CellChangeTimes->{
  3.9887958550706577`*^9, {3.988795903686308*^9, 3.9887959195901127`*^9}},
 CellLabel->"Out[38]=",ExpressionUUID->"a5bc06b2-6d11-4600-9807-dfb323bc46b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sum1", "[", 
    RowBox[{"c_", ",", "n_"}], "]"}], "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "^", "k"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "c"}], "]"}], "/", 
       RowBox[{"k", "!"}]}], " ", 
      RowBox[{"1", "/", "k"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sum2", "[", 
    RowBox[{"c_", ",", "n_"}], "]"}], "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "^", "k"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "c"}], "]"}], "/", 
       RowBox[{"k", "!"}]}], " ", 
      RowBox[{"1", "/", 
       RowBox[{"k", "^", "2"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sum3", "[", 
    RowBox[{"c_", ",", "n_"}], "]"}], "=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"c", "^", "k"}], " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"-", "c"}], "]"}], "/", 
       RowBox[{"k", "!"}]}], " ", 
      RowBox[{"1", "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "k"}], ")"}], "^", "2"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"moment2", "[", 
    RowBox[{"c_", ",", "n_"}], "]"}], "=", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"sum2", "[", 
      RowBox[{"c", ",", "n"}], "]"}], "/", 
     RowBox[{
      RowBox[{"sum1", "[", 
       RowBox[{"c", ",", "n"}], "]"}], "^", "2"}]}], " ", "*", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"sum3", "[", 
        RowBox[{"c", ",", "n"}], "]"}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"moment2", "[", 
    RowBox[{"x", ",", "70"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "20", ",", "26"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.988857939875503*^9, 3.988858091412093*^9}, {
