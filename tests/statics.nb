             FractionBox[
              SqrtBox[
               RowBox[{
                SuperscriptBox["b", "2"], " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "+", "c"}], ")"}], "2"]}]], "b"], "+", 
             RowBox[{"2", " ", "j"}]}], ")"}]}], "]"}]}], 
        RowBox[{
         RowBox[{"Gamma", "[", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"(", 
            RowBox[{"3", "+", "c", "-", 
             FractionBox[
              SqrtBox[
               RowBox[{
                SuperscriptBox["b", "2"], " ", 
                SuperscriptBox[
                 RowBox[{"(", 
