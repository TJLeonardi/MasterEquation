Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"naivevar", " ", "=", " ", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{"l", "^", 
           RowBox[{"(", 
            RowBox[{"-", "j"}], ")"}]}], " ", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"1", "/", "l"}]}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", "Infinity"}], "}"}]}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"mu", "->", "0.000001"}], ",", 
       RowBox[{"b", "->", "1"}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"l", ",", "50", ",", "100"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.990262459827162*^9, 3.990262462015216*^9}, {
