Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sum1", "[", 
   RowBox[{"c_", ",", "b_", ",", "q_", ",", "m_", ",", "p_"}], "]"}], "=", 
  RowBox[{"NSum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"c", "^", "k"}], " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", "c"}], "]"}], "/", 
      RowBox[{"k", "!"}]}], " ", 
     RowBox[{"1", "/", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"b", " ", "k"}], "+", "q", "+", "m"}], ")"}], "^", "p"}]}]}],
     ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", "Infinity"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c0", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m0", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"c0", " ", "b0", "  ", 
     RowBox[{
      RowBox[{"sum1", "[", 
       RowBox[{"c0", ",", "b0", ",", "x", ",", "m0", ",", "1"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"m0", " ", 
         RowBox[{"sum1", "[", 
          RowBox[{"c0", ",", "b0", ",", "x", ",", "m0", ",", "1"}], "]"}]}]}],
        ")"}]}]}], "-", 
    RowBox[{"c0", " ", 
     RowBox[{"b0", "/", 
      RowBox[{"(", 
       RowBox[{"x", "+", 
        RowBox[{"c0", " ", "b0"}]}], ")"}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.98955368549375*^9, 3.989553691564739*^9}, {
   3.989565414722227*^9, 3.989565695543895*^9}, 3.989566568609267*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"5eace68d-a419-4769-863c-db911cd37dc5"],

Cell[BoxData[
 TemplateBox[{
  "NSum", "nsnum", 
   "\"Summand (or its derivative) \
\\!\\(\\*FractionBox[RowBox[{SuperscriptBox[\\\"c\\\", \\\"k\\\"], \\\" \\\", \
RowBox[{\\\"Exp\\\", \\\"[\\\", RowBox[{\\\"-\\\", \\\"c\\\"}], \
\\\"]\\\"}]}], RowBox[{RowBox[{\\\"k\\\", \\\"!\\\"}], \\\" \\\", \
SuperscriptBox[RowBox[{\\\"(\\\", RowBox[{RowBox[{\\\"b\\\", \\\" \\\", \\\"k\
\\\"}], \\\"+\\\", \\\"q\\\", \\\"+\\\", \\\"m\\\"}], \\\")\\\"}], \
\\\"p\\\"]}]]\\) is not numerical at point \\!\\(\\*RowBox[{\\\"k\\\"}]\\) = \
\\!\\(\\*RowBox[{\\\"15\\\"}]\\).\"", 2, 42, 1, 20596657927493778567, "Local"},
