        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "c"}], "+", "1"}], ")"}], "/", "x"}]}], "+", "  ", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"c", "^", "2"}], "/", 
           RowBox[{"x", "^", "2"}]}], "-", 
          RowBox[{"c", "/", 
           RowBox[{"x", "^", "3"}]}]}], ")"}]}]}], "==", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "b"}], "/", 
        RowBox[{"x", "^", "3"}]}], "+", 
       RowBox[{"c", " ", 
        RowBox[{
         RowBox[{"g", "[", "x", "]"}], "/", 
         RowBox[{"x", "^", "2"}]}]}]}]}], "}"}], ",", 
